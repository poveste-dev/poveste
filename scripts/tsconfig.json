{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "typeRoots": [
      "../packages/poveste/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "*.mts",
    "checks/*.ts"
  ]
}
