{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "typeRoots": [
      "../packages/poveste/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "checks/**/*.ts",
    "checks/**/*.mts",
    "hooks/*.ts",
    "release/*.ts"
  ]
}
