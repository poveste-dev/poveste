{
  "name": "poveste-monorepo",
  "version": "0.14.0",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint . --cache",
    "lint:gate": "eslint .",
    "lint:fix": "eslint . --fix --cache",
    "build": "pnpm run -r build",
    "watch": "pnpm run build && pnpm run -r --parallel --filter \"./packages/**\" watch",
    "test": "pnpm run -r --parallel --filter \"./packages/**\" test",
    "test:dev": "pnpm run -r --parallel --filter \"./packages/**\" test:dev",
    "test:e2e": "playwright test",
    "bench": "node bench/run.mjs",
    "bench:smoke": "vitest run --project bench",
    "story:build:e2e": "pnpm --filter ./examples/vue --filter ./examples/vue-tailwind --filter ./examples/nuxt --filter ./examples/svelte --filter ./examples/sveltekit --filter ./examples/quasar --filter ./examples/vike run story:build",
    "test:smoke": "bash scripts/release/smoke-test.sh",
    "test:starters": "vitest run --project scripts checks/starters --tags-filter=\"check && !after-publish\"",
    "test:starters:release": "vitest run --project scripts checks/starters --tags-filter=\"check && after-publish\"",
    "test:versions": "vitest run --project scripts checks/versions",
    "test:node-versions": "vitest run --project scripts checks/node-versions",
    "test:package-tests": "vitest run --project scripts checks/package-tests",
    "test:doc-coverage": "vitest run --project scripts checks/doc-coverage",
    "test:readmes": "vitest run --project scripts checks/readmes",
    "test:example-wiring": "vitest run --project scripts checks/example-wiring",
    "test:recipes": "vitest run --project scripts checks/recipes",
    "test:config-reference": "vitest run --project scripts checks/config-reference",
    "test:docs-site": "vitest run --project scripts checks/docs-site --tags-filter=\"check && !network\"",
    "test:docs-site:live": "vitest run --project scripts checks/docs-site --tags-filter=\"check && network\"",
    "test:audit": "vitest run --project scripts checks/audit --tags-filter=\"check && network\"",
    "test:publishable": "vitest run --project scripts checks/publishable --tags-filter=\"check && network\"",
    "test:published": "vitest run --project scripts checks/published",
    "test:packaging": "vitest run --project scripts checks/publishable --tags-filter=\"check && !network\"",
    "test:scripts": "vitest run --project scripts --tags-filter=\"!check\"",
    "typecheck:scripts": "tsc -p scripts",
    "test:checks": "vitest run --project scripts --tags-filter=\"check && !build && !network\"",
    "test:docs": "vitest run --project scripts --tags-filter=\"check && docs && !network\"",
    "test:tags": "vitest run --project scripts checks/local-tags",
    "release": "pnpm run release:check && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release/release.ts",
    "release:report": "pnpm pipeline checks --full --no-cache --include-workspace-root",
    "test:task-graph": "vitest run --project scripts checks/task-graph",
    "test:tsconfig-base": "vitest run --project scripts checks/tsconfig-base",
    "test:step-gates": "vitest run --project scripts checks/step-gates",
    "release:check": "pnpm run test:checks && pnpm run build && pnpm run lint:gate && pnpm run test:doc-coverage && pnpm run test:publishable && pnpm run test:audit && pnpm run test:scripts && pnpm run test && pnpm run test:smoke",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "update": "pnpm --recursive update --latest",
    "test:mirrors": "vitest run --project scripts checks/mirrored-conformance",
    "test:conformance-config": "vitest run --project scripts checks/conformance-config",
    "test:preview-position": "vitest run --project scripts checks/preview-position",
    "test:bundle-size": "vitest run --project scripts checks/bundle-size",
    "sync:conformance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-conformance.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify/vue": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@poveste/vendors": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "@tailwindcss/postcss": "catalog:",
    "@vue/compiler-sfc": "^3.5.41",
    "@vueuse/core": "catalog:",
    "axe-core": "^4.13.0",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "floating-vue": "5.2.2",
    "lint-staged": "^17.5.1",
    "postcss": "catalog:",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.14.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitepress": "1.6.4",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
