{
  "name": "poveste-monorepo",
  "version": "0.9.0",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "build": "pnpm run -r build",
    "watch": "pnpm run build && pnpm run -r --parallel --filter \"./packages/**\" watch",
    "test": "pnpm run -r --parallel --filter \"./packages/**\" test",
    "test:dev": "pnpm run -r --parallel --filter \"./packages/**\" test:dev",
    "test:examples": "pnpm run -r --workspace-concurrency 1 --filter \"./examples/vue**\"  test:examples",
    "test:examples:all": "pnpm run -r --workspace-concurrency 1 --filter \"./examples/**\" test:examples",
    "test:e2e": "playwright test",
    "bench": "node bench/run.mjs",
    "story:build:e2e": "pnpm --filter ./examples/vue3 --filter ./examples/vue3-tailwind --filter ./examples/nuxt4 --filter ./examples/svelte5 --filter ./examples/sveltekit run story:build",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:starters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-starters.ts",
    "test:starters:release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-starters.ts --after-publish",
    "test:versions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-versions.ts",
    "test:readmes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-readmes.ts",
    "test:example-wiring": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-example-wiring.ts",
    "test:recipes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-recipes.ts",
    "test:docs-site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-site.ts",
    "test:docs-site:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-site.ts --live",
    "test:publishable": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-publishable.ts",
    "test:published": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-published.ts",
    "test:packaging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-publishable.ts --offline",
    "test:scripts": "vitest run scripts",
    "release": "pnpm run release:check && bumpp --yes --release",
    "release:check": "pnpm run lint && pnpm run test:versions && pnpm run test:readmes && pnpm run test:example-wiring && pnpm run test:recipes && pnpm run build && pnpm run test:publishable && pnpm run test:scripts && pnpm run test && pnpm run test:smoke",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "update": "pnpm --recursive update --latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@iconify/vue": "^4.1.2",
    "@playwright/test": "^1.62.1",
    "@poveste/vendors": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "@tailwindcss/postcss": "catalog:",
    "@vueuse/core": "catalog:",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "floating-vue": "5.2.2",
    "postcss": "catalog:",
    "rimraf": "^6.0.1",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitepress": "1.6.4",
    "vitest": "catalog:"
  }
}
