{
  "name": "@poveste/plugin-vue",
  "type": "module",
  "version": "0.21.0",
  "description": "Poveste plugin for Vue 3: stories as .vue files, controls, and a props, slots and events table read from your components' types",
  "author": {
    "name": "Sorin Gitlan",
    "url": "https://x.com/50rayn"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-vue"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste",
    "histoire",
    "storybook",
    "component-playground",
    "component-explorer",
    "stories",
    "styleguide",
    "design-system",
    "vite",
    "vue",
    "vue3",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/client.d.ts",
      "default": "./dist/bundled/client/client.js"
    },
    "./collect": {
      "types": "./dist/client/server.d.ts",
      "default": "./dist/bundled/client/server.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/bundled/testing/index.js"
    },
    "./components": {
      "types": "./components.d.ts"
    },
    "./client-dev": {
      "default": "./src/client/client.ts"
    },
    "./collect-dev": {
      "default": "./src/client/server.ts"
    },
    ".": {
      "types": "./dist/index.node.d.ts",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "main": "dist/index.js",
  "types": "dist/index.node.d.ts",
  "files": [
    "!src/**/*.spec.ts",
    "!src/**/__tests__",
    "client.d.ts",
    "collect.d.ts",
    "components.d.ts",
    "dist",
    "src",
    "testing.d.ts"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "rimraf dist && vite build && tsc -d -P tsconfig.build.json && pnpm run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "watch": "concurrently \"vite build --watch\" \"tsc -d -P tsconfig.build.json --watch\" \"pnpm run build:types --watch\"",
    "test": "vitest run",
    "test:story-tests": "vitest run --config vitest.story-tests.config.ts",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "poveste": "workspace:^",
    "vitest": "^5.0.0",
    "vue": "^3.5.43"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "change-case": "^5.4.4",
    "ignore": "^7.0.10",
    "launch-editor": "^2.14.2",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17",
    "vue-component-meta": "^3.3.13"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "poveste": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.44",
    "vue-vapor-rc": "npm:vue@3.6.0-rc.10"
  }
}
