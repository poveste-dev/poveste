{
  "name": "@poveste/plugin-vue",
  "type": "module",
  "version": "0.5.0",
  "description": "Poveste plugin for Vue.js support",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/client.d.ts",
      "default": "./dist/bundled/client/client.js"
    },
    "./collect": {
      "types": "./dist/client/server.d.ts",
      "default": "./dist/bundled/client/server.js"
    },
    "./components": {
      "types": "./components.d.ts"
    },
    "./client-dev": {
      "default": "./src/client/client.ts"
    },
    "./collect-dev": {
      "default": "./src/client/server.ts"
    },
    ".": {
      "types": "./dist/index.node.d.ts",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "main": "dist/index.js",
  "types": "dist/index.node.d.ts",
  "scripts": {
    "build": "rimraf dist && vite build && tsc -d -P tsconfig.build.json && pnpm run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "watch": "concurrently \"vite build --watch\" \"tsc -d -P tsconfig.build.json --watch\" \"pnpm run build:types --watch\"",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "poveste": "workspace:^",
    "vue": "^3.5.26"
  },
  "dependencies": {
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "change-case": "^5.4.4",
    "globby": "^14.0.2",
    "launch-editor": "^2.9.1",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "poveste": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.26"
  }
}
