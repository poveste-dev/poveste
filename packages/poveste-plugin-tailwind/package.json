{
  "name": "@poveste/plugin-tailwind",
  "type": "module",
  "version": "0.11.0",
  "description": "Poveste plugin that renders a Tailwind design system as a story",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-tailwind"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste",
    "histoire",
    "storybook",
    "component-playground",
    "component-explorer",
    "stories",
    "styleguide",
    "design-system",
    "vite",
    "tailwind",
    "tailwindcss",
    "design-tokens",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -d",
    "watch": "tsc -d -w --sourceMap",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "poveste": "workspace:^",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@poveste/shared": "workspace:*",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "poveste": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
