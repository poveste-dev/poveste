{
  "name": "poveste",
  "type": "module",
  "version": "0.14.0",
  "description": "Interactive component playgrounds for Vue, Nuxt, Svelte, SvelteKit and Quasar — a drop-in fork of histoire, with Quasar support histoire does not ship.",
  "author": {
    "name": "Sorin Gitlan",
    "url": "https://x.com/50rayn"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste",
    "histoire",
    "storybook",
    "component-playground",
    "component-explorer",
    "stories",
    "styleguide",
    "design-system",
    "vite",
    "vue",
    "svelte",
    "nuxt",
    "sveltekit",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./plugin": {
      "types": "./plugin.d.ts",
      "default": "./plugin.js"
    },
    "./*": "./*"
  },
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./index.d.ts",
  "bin": {
    "poveste": "./bin.mjs",
    "histoire": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "client.d.ts",
    "client.js",
    "dist",
    "index.d.ts",
    "plugin.d.ts",
    "plugin.js"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w --sourceMap",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@akryum/tinypool": "^0.3.1",
    "@poveste/app": "workspace:^",
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "connect": "^3.7.0",
    "defu": "^6.1.4",
    "diacritics": "^1.3.0",
    "es-module-lexer": "^3.0.2",
    "fs-extra": "^11.2.0",
    "globby": "^16.2.4",
    "jiti": "^2.4.1",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-emoji": "^3.1.0",
    "mrmime": "^2.0.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "sade": "^1.8.1",
    "shiki": "^4.4.3",
    "sirv": "^3.0.0",
    "unhead": "^3.1.0"
  },
  "devDependencies": {
    "@types/diacritics": "^1.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.1",
    "@types/picomatch": "^4.0.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
