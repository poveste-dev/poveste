{
  "name": "@poveste/plugin-percy",
  "type": "module",
  "version": "0.5.3",
  "description": "Poveste plugin to take screenshots with Percy for visual regression testing",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-percy"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -d",
    "watch": "tsc -d -w --sourceMap"
  },
  "peerDependencies": {
    "poveste": "workspace:^"
  },
  "dependencies": {
    "@percy/sdk-utils": "^1.30.4",
    "defu": "^6.1.4",
    "fs-extra": "^11.2.0",
    "pathe": "^1.1.2",
    "puppeteer": "^23.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "poveste": "workspace:*",
    "typescript": "catalog:"
  }
}
