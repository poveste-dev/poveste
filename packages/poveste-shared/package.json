{
  "name": "@poveste/shared",
  "type": "module",
  "version": "0.2.1",
  "description": "Shared utilities for Poveste",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*",
    "./client-node": "./dist/client/server/run.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w --sourceMap",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@poveste/vendors": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "chokidar": "^4.0.1",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1",
    "unhead": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
