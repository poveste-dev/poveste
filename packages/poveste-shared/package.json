{
  "name": "@poveste/shared",
  "type": "module",
  "version": "0.8.0",
  "description": "Shared utilities for Poveste",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-shared"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w --sourceMap",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@poveste/vendors": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "chokidar": "^4.0.1",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1",
    "unhead": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
