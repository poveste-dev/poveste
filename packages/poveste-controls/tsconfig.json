{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "rootDir": "src",
    "paths": {
      "@iconify/vue": [
        "./node_modules/@poveste/vendors/iconify"
      ],
      "pinia": [
        "./node_modules/@poveste/vendors/pinia"
      ],
      "scroll-into-view-if-needed": [
        "./node_modules/@poveste/vendors/scroll"
      ],
      "vue-router": [
        "./node_modules/@poveste/vendors/vue-router"
      ],
      "@vueuse/core": [
        "./node_modules/@poveste/vendors/vue-use"
      ],
      "vue": [
        "./node_modules/@poveste/vendors/vue"
      ]
    },
    "types": [
      "node"
    ],
    "outDir": "dist",
    "preserveSymlinks": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "generated/**/*",
    "dist/**/*",
    "src/**/*.spec.ts"
  ]
}
