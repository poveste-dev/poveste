{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "rootDir": "src",
    "types": [
      "node"
    ],
    "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "generated/**/*",
    "dist/**/*",
    "src/**/*.spec.ts"
  ]
}
