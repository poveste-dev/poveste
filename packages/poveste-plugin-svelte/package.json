{
  "name": "@poveste/plugin-svelte",
  "type": "module",
  "version": "0.6.1",
  "description": "Poveste plugin for Svelte 5 and SvelteKit support",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-svelte"
  },
  "keywords": [
    "poveste",
    "histoire",
    "storybook",
    "component-playground",
    "component-explorer",
    "stories",
    "styleguide",
    "design-system",
    "vite",
    "svelte",
    "svelte5",
    "sveltekit",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./client": "./dist/client/index.js",
    "./collect": "./dist/collect/index.js",
    ".": "./dist/index.node.js",
    "./*": "./*"
  },
  "main": "./dist/index.node.js",
  "module": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "scripts": {
    "build": "rimraf dist && vite build && tsc -d -P tsconfig.build.json && pnpm run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "watch": "concurrently \"vite build --watch\" \"tsc -d -P tsconfig.build.json --watch\" \"pnpm run build:types --watch\""
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "poveste": "workspace:^",
    "svelte": "^5.46.4"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "change-case": "^5.4.4",
    "globby": "^14.0.2",
    "launch-editor": "^2.9.1",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "poveste": "workspace:*",
    "svelte": "5.55.0",
    "svelte-preprocess": "^6.0.3",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
