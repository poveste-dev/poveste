{
  "name": "@poveste/app",
  "type": "module",
  "version": "0.2.1",
  "description": "Pre-bundled UI for Poveste",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-app"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle-index.js"
    },
    "./*": "./*"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && vite build && pnpm run build:css && node ./scripts/copy.mjs",
    "build:css": "postcss src/app/style/main.pcss -o ./dist/style.css",
    "test": "vitest run",
    "test:dev": "vitest",
    "watch": "concurrently \"vite build --watch\" \"pnpm run build:css --watch\" \"node ./scripts/watchAndCopy.mjs\""
  },
  "dependencies": {
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "fuse.js": "^7.0.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "chokidar": "^4.0.1",
    "concurrently": "^9.1.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.2",
    "pathe": "^1.1.2",
    "postcss": "catalog:",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.26"
  }
}
