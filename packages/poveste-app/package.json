{
  "name": "@poveste/app",
  "type": "module",
  "version": "0.15.0",
  "description": "Pre-bundled UI for Poveste",
  "author": {
    "name": "Sorin Gitlan",
    "url": "https://x.com/50rayn"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-app"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/bundle-index.js",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm run icons && rimraf dist && vite build && pnpm run build:css && node ./scripts/copy.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build:css": "postcss src/app/style/main.pcss -o ./dist/style.css",
    "icons": "node ./scripts/icons.mjs",
    "test": "vitest run",
    "test:dev": "vitest",
    "watch": "concurrently \"vite build --watch\" \"pnpm run build:css --watch\" \"node ./scripts/watchAndCopy.mjs\""
  },
  "dependencies": {
    "@poveste/controls": "workspace:^",
    "@poveste/shared": "workspace:^",
    "@poveste/vendors": "workspace:^",
    "fuse.js": "^7.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/noto-sans-display": "^5.3.0",
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/fluent": "1.2.58",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/utils": "^3.1.7",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "fs-extra": "^11.2.0",
    "globby": "^16.2.4",
    "pathe": "^2.0.3",
    "postcss": "catalog:",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "catalog:"
  }
}
