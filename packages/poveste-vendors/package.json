{
  "name": "@poveste/vendors",
  "type": "module",
  "version": "0.15.0",
  "description": "Poveste-owned copies of the libraries its chrome runs on",
  "author": {
    "name": "Sorin Gitlan",
    "url": "https://x.com/50rayn"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-vendors"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./iconify": {
      "types": "./iconify.d.ts",
      "default": "./iconify.js"
    },
    "./pinia": {
      "types": "./pinia.d.ts",
      "default": "./pinia.js"
    },
    "./scroll": {
      "types": "./scroll.d.ts",
      "default": "./scroll.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./vue-router": {
      "types": "./vue-router.d.ts",
      "default": "./vue-router.js"
    },
    "./vue-use": {
      "types": "./vue-use.d.ts",
      "default": "./vue-use.js"
    }
  },
  "files": [
    "iconify.d.ts",
    "iconify.js",
    "pinia.d.ts",
    "pinia.js",
    "scroll.d.ts",
    "scroll.js",
    "vue-router.d.ts",
    "vue-router.js",
    "vue-use.d.ts",
    "vue-use.js",
    "vue.d.ts",
    "vue.js"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "poveste-iconify-vue": "npm:@iconify/vue@^5.0.1",
    "poveste-pinia": "npm:pinia@^4.0.3",
    "poveste-scroll-into-view": "npm:scroll-into-view-if-needed@^3.1.0",
    "poveste-vue": "npm:vue@^3.5.26",
    "poveste-vue-router": "npm:vue-router@^5.3.1",
    "poveste-vueuse-core": "npm:@vueuse/core@^15.0.0"
  }
}
