{
  "name": "@poveste/plugin-quasar",
  "type": "module",
  "version": "0.8.2",
  "description": "Poveste plugin that builds a book inside a Quasar project",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "homepage": "https://poveste.dev",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-quasar"
  },
  "bugs": "https://github.com/poveste-dev/poveste/issues",
  "keywords": [
    "poveste",
    "histoire",
    "storybook",
    "component-playground",
    "component-explorer",
    "stories",
    "styleguide",
    "vite",
    "vue",
    "quasar",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./setup": {
      "types": "./setup.d.ts",
      "default": "./setup.js"
    },
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "setup.d.ts",
    "setup.js"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -d",
    "watch": "tsc -d -w --sourceMap",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "@quasar/app-vite": "^3.8.0",
    "poveste": "workspace:^",
    "quasar": "^2.24.0",
    "vue": "^3.5.26"
  },
  "dependencies": {
    "@poveste/shared": "workspace:*"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.8.1",
    "@types/node": "^22.10.1",
    "poveste": "workspace:*",
    "quasar": "^2.27.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.26"
  }
}
