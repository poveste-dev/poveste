{
  // `pnpm-workspace.yaml` pins the compiler to an exact 5.6.3, and without this
  // the editor type-checks with whatever TypeScript the installed VS Code build
  // ships. That points the wrong way round: a contributor on a newer bundled
  // compiler sees fewer errors than `vue-tsc` will produce, not more.
  "typescript.tsdk": "node_modules/typescript/lib",
  // Ask once, rather than silently staying on the bundled build.
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Tailwind v4 is CSS-first: point the IntelliSense at the CSS entrypoints.
  "tailwindCSS.experimental.configFile": {
    "packages/poveste-app/src/app/style/main.pcss": "packages/poveste-app/**",
    "packages/poveste-controls/src/style/main.css": "packages/poveste-controls/**"
  },

  // Disable the default formatter, use eslint instead
  "editor.formatOnSave": false,

  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },

  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml",
    "gql",
    "graphql"
  ]
}
