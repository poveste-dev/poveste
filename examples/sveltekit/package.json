{
  "name": "sveltekit",
  "type": "module",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "sk:dev": "vite dev",
    "sk:build": "vite build",
    "sk:package": "svelte-kit package",
    "sk:preview": "vite preview",
    "sk:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sk:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "story:dev": "poveste dev",
    "story:build": "poveste build",
    "story:preview": "poveste preview --port 4570",
    "test": "playwright test",
    "test:dev": "playwright test --ui",
    "test:examples": "pnpm run story:build && pnpm run test"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.1.0",
    "cookie": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@poveste/plugin-svelte": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/cookie": "^1.0.0",
    "lottie-web": "^5.12.2",
    "poveste": "workspace:*",
    "sass": "^1.82.0",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
