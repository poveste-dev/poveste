{
  "name": "sveltekit",
  "type": "module",
  "version": "0.17.2",
  "private": true,
  "scripts": {
    "sk:dev": "vite dev",
    "sk:build": "vite build",
    "sk:package": "svelte-kit package",
    "sk:preview": "vite preview",
    "sk:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sk:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepare": "svelte-kit sync || echo ''",
    "story:dev": "poveste dev",
    "story:build": "poveste build",
    "story:preview": "poveste preview --port 4570"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@poveste/plugin-svelte": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "lottie-web": "^5.12.2",
    "poveste": "workspace:*",
    "sass": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "vite": "^8.3.1"
  }
}
