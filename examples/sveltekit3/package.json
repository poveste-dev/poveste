{
  "name": "sveltekit3",
  "type": "module",
  "version": "0.18.2",
  "private": true,
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "sk:dev": "vite dev",
    "sk:build": "vite build",
    "sk:preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "story:dev": "poveste dev",
    "story:build": "poveste build",
    "story:preview": "poveste preview --port 4575"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@poveste/plugin-svelte": "workspace:*",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "poveste": "workspace:*",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "catalog:",
    "vite": "^8.3.1"
  }
}
