{
  "name": "poveste-example-vue",
  "type": "module",
  "version": "0.20.0",
  "private": true,
  "scripts": {
    "dev:pvt": "nodemon --watch ../../packages/poveste/dist --watch ../../packages/poveste-plugin-vue/dist --exec \"rm -rf ./node_modules/.pvt* && POVESTE_DEV=true poveste dev\"",
    "story:dev": "poveste dev",
    "story:build": "poveste build",
    "story:preview": "poveste preview --port 4567",
    "test:stories": "vitest run"
  },
  "dependencies": {
    "floating-vue": "5.4.0",
    "lottie-web": "^5.12.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/el": "^1.2.2",
    "@playwright/test": "^1.64.1",
    "@poveste/app": "workspace:*",
    "@poveste/plugin-tailwind": "workspace:*",
    "@poveste/plugin-vue": "workspace:*",
    "@poveste/vendors": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "poveste": "workspace:*",
    "sass": "^1.105.2",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-i18n": "^11.4.16"
  }
