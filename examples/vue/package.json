    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@poveste/app": "workspace:*",
    "@poveste/plugin-tailwind": "workspace:*",
    "@poveste/plugin-vue": "workspace:*",
    "@poveste/vendors": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "nodemon": "^3.1.14",
    "poveste": "workspace:*",
    "sass": "^1.82.0",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vue-i18n": "^11.4.12"
  }
